<Project>

  <!--
    Central Package Management stops here. Everything under external/ is vendored source from
    another repository (Tessera, as a git submodule): those projects pin their own package
    versions inline, and CPM forbids that. Rather than patch a submodule we cannot own, this file
    opts the whole subtree out — MSBuild uses the nearest Directory.Packages.props, so the root
    one never reaches them.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

</Project>
